# ── Kite Connect API ────────────────────────────────────────────────────────
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=http://127.0.0.1:3000/api/auth/kite

# Set KITE_ACCESS_TOKEN directly if you already have a valid token (resets at midnight IST).
# Otherwise set KITE_REQUEST_TOKEN (from OAuth redirect) and the service will exchange it.
KITE_ACCESS_TOKEN=
KITE_REQUEST_TOKEN=

# Comma-separated list of instrument_token:SYMBOL pairs to subscribe to
# Tokens can be found via: https://api.kite.trade/instruments/NSE
KITE_INSTRUMENT_TOKENS=738561:RELIANCE,260105:BANKNIFTY,256265:NIFTY 50

# ── External Data APIs ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=s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
MARKETAUX_API_KEY=EL049VtJaTFG0qNbdIP2vuIkes8KuOXBx9AkPRFj
NEWSDATA_API_KEY=pub_662d1fc25c964696b11388503ddb058b

# ── Docker Infrastructure ───────────────────────────────────────────────────
# Kafka — ingestion service reads KAFKA_BROKER_URL (falls back to KAFKA_BROKERS)
KAFKA_BROKER_URL=localhost:9092
KAFKA_BROKERS=localhost:9092
KAFKA_BROKERS_INTERNAL=broker:29092

# QuestDB
QUESTDB_POSTGRES_URL=postgresql://admin:quest@questdb:8812/qdb
QUESTDB_ILP_ADDR=127.0.0.1:9009
QUESTDB_ILP_ADDR_INTERNAL=questdb:9009

# Redis
REDIS_URL=redis://redis:6379

# WebSocket gateway port (frontend ↔ aggregator)
WEBSOCKET_PORT=8080

# ── Auth Service (Identity Vault) ────────────────────────────────────────────
# PostgreSQL connection for identity tables (users, credentials, MFA vault)
POSTGRES_AUTH_URL=postgresql://auth_admin:auth_secret_dev@localhost:5432/ai_trade_auth
POSTGRES_AUTH_PASSWORD=auth_secret_dev
# CRITICAL: Generate once with `openssl rand -hex 32`. NEVER rotate (invalidates all hashes).
AUTH_PEPPER=<generate-with-openssl-rand-hex-32>
AUTH_PORT=3001

# ── JWT Session Layer ────────────────────────────────────────────────────────
# RS256 asymmetric key pair paths (relative to auth/ dir)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
# Access token TTL in seconds (default: 900 = 15 minutes)
JWT_ACCESS_TTL_SECONDS=900
# Refresh token TTL in seconds (default: 604800 = 7 days)
JWT_REFRESH_TTL_SECONDS=604800
