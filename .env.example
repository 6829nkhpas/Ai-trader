# ══════════════════════════════════════════════════════════════════════════════
# AI-TRADER — Environment Configuration Template
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your API keys.
# Every variable listed here is actively referenced by at least one service.
# ══════════════════════════════════════════════════════════════════════════════

# ── Kite Connect API (Ingestion, Aggregator, Tauri) ─────────────────────────
KITE_API_KEY=
KITE_API_SECRET=

# Set KITE_ACCESS_TOKEN directly if you already have a valid token (resets at midnight IST).
# Otherwise set KITE_REQUEST_TOKEN (from OAuth redirect) and the ingestion service will exchange it.
KITE_ACCESS_TOKEN=
KITE_REQUEST_TOKEN=

# ── Sentiment Agent — NewsData.io ───────────────────────────────────────────
# Used by agents/sentiment/src/fetcher.js to pull latest news articles.
NEWSDATA_API_KEY=
# NEWSDATA_PAGE_SIZE=3
# NEWSDATA_LANGUAGE=en
# Finnhub — company profile + basic financials context (best-effort enrichment).
FINNHUB_API_KEY=
# FINNHUB_SYMBOL_SUFFIX=.NS
# SENTIMENT_NEWS_BUCKETS=4
#
# Sentiment_Classifier endpoint used by the Rust Tool_Server's get_news_context
# (frontend/src-tauri/src/quant/tool_server.rs) to score news conviction.
# Configurable so the classifier can be relocated without code changes. When
# unset it defaults to the value below. If the endpoint is unconfigured or
# unreachable, get_news_context degrades cleanly to headlines-only and marks the
# classification explicitly unavailable (it does NOT imply a neutral read).
# SENTIMENT_SERVICE_URL=http://localhost:8090/sentiment

# ── LLM Configuration ────────────────────────────────────────────────────────
# HOSTED MODE (default): the deep-quant service does NOT use an env LLM key.
# Each analysis run resolves the REQUESTING user's OpenRouter key from the
# backend internal endpoint and bills usage against that user's plan. LLM_API_KEY
# is intentionally left blank and is only consulted for a fully local/self-hosted
# run with no per-user backend. LLM_MODEL selects the OpenRouter model id
# (e.g. deepseek/deepseek-r1) used for every run.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-r1

# ── Per-user LLM key resolution (hosted mode) ────────────────────────────────
# The deep-quant service (droplet, IP-whitelisted in the backend's
# INTERNAL_ALLOWED_IPS) resolves each user's OpenRouter key server-to-server and
# calls OpenRouter with it. No LLM secret lives on the client or in this file.
INTERNAL_API_BASE_URL=https://api-web.stratai.live
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# INTERNAL_API_KEY_TTL=300      # seconds to cache a resolved key per user
# INTERNAL_API_TIMEOUT=8        # HTTP timeout for the internal endpoint
# Reasoning effort level: low | medium | high | xhigh. Leave blank to omit it.
LLM_EFFORT=high
# Wire field name for the effort value. Defaults to the OpenAI-standard
# `reasoning_effort`; set to `effort` if your provider expects that name.
LLM_EFFORT_FIELD=reasoning_effort
# LLM_TIMEOUT_SECS=120

# ── Docker Infrastructure ───────────────────────────────────────────────────
# Kafka — used by ingestion, aggregator, technical, predictive, quant-rag, sentiment
KAFKA_BROKER_URL=localhost:19092
KAFKA_BROKERS=localhost:19092
KAFKA_BROKERS_INTERNAL=broker:29092

# QuestDB — used by ingestion (PG + ILP), Tauri (PG for historical queries)
QUESTDB_POSTGRES_URL=postgresql://admin:quest@localhost:8812/qdb
QUESTDB_ILP_ADDR=127.0.0.1:9009
QUESTDB_ILP_ADDR_INTERNAL=questdb:9009

# ── QuestDB auth (production/thin-client) ───────────────────────────────────
# Shared beta credential guarding remote QuestDB access:
#   • PG wire (8812) uses QuestDB's native user/password (QDB_PG_USER/PASSWORD).
#   • HTTP  (9000) sits behind a Caddy basic-auth gateway (see infra/caddy).
# The desktop app bakes QUESTDB_USER/QUESTDB_PASSWORD at build time (via the
# release pipeline's GitHub secrets) so shipped installers authenticate.
# On the SERVER, set all three (compose reads them):
QUESTDB_USER=admin
QUESTDB_PASSWORD=change-me-strong-password
# bcrypt hash of QUESTDB_PASSWORD for the Caddy gateway. Generate with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'change-me-strong-password'
QUESTDB_PASSWORD_HASH=

# Redis — used by sentiment agent cache and auth service
REDIS_URL=redis://localhost:6379

# ── Kafka Topics ────────────────────────────────────────────────────────────
KAFKA_TOPIC_SIGNALS=technical_signals
KAFKA_TOPIC_SENTIMENT=sentiment_signals

# ── Service Ports ───────────────────────────────────────────────────────────
WEBSOCKET_PORT=8080
INGESTION_CONTROL_PORT=8085
KITE_API_PORT=8087

# ── Internal Service URLs (Tauri backend + Python deep-quant agent) ──────────
# Deep Quant FastAPI service base URL. The Tauri backend POSTs /run, /qa, /resume
# here; the Python service itself binds DEEP_QUANT_HOST:DEEP_QUANT_PORT.
DEEP_QUANT_URL=http://localhost:8086
DEEP_QUANT_HOST=0.0.0.0
DEEP_QUANT_PORT=8086
# Local Rust quant tool server (Tauri quant/tool_server.rs). The Python agent's
# tools call RUST_TOOL_SERVER_URL; the server binds QUANT_TOOL_SERVER_ADDR
# (or 127.0.0.1:QUANT_TOOL_SERVER_PORT when ADDR is unset).
RUST_TOOL_SERVER_URL=http://localhost:8084
QUANT_TOOL_SERVER_PORT=8084
# QuestDB HTTP query endpoint (Python deep-quant candle/options reads).
QUESTDB_HTTP_URL=http://127.0.0.1:9000

# ── Session Telemetry (agents/deep-quant-loop/telemetry.py) ─────────────────
# Best-effort, off-hot-path measurement of Deep Quant Agent runs. All values are
# optional; each falls back to the documented default when unset/empty/invalid.
# Dedicated SQLite store for Session_Records + Funnel_Events (separate from the
# Trade_Journal). Defaults to telemetry.db beside the deep-quant-loop module.
# TELEMETRY_DB_PATH=agents/deep-quant-loop/telemetry.db
# A metric group is flagged as a weak prior when its session count is below this.
# TELEMETRY_WEAK_PRIOR_MIN_SESSIONS=20
# A still-open (paused) session older than this many seconds is classified
# `incomplete`. Default 86400 (24 hours).
# TELEMETRY_INCOMPLETE_HORIZON_SECONDS=86400

# ── Adaptive Opportunity Engine (agents/deep-quant-loop/opportunity.py) ─────
# Governs how the Deep Quant Agent hunts: the tiered opportunity ladder, the
# bounded hunt (Watch_Cap / Session_Budget), the invalidation post-mortem, and
# the opt-in Heartbeat_Monitor. All values are optional and fall back to the
# documented default when unset/empty/invalid.
#
# HEARTBEAT_MONITOR — off by default. When a run registers a price watch it
# suspends and, by default, stays idle in the glass box until the target or the
# invalidation level is hit. Enable the heartbeat to have the watcher wake the run
# on a fixed cadence during the wait, re-check the setup with fresh data, and
# stream an updated Best_Current_Read into the glass box (so it no longer sits
# still). Cost: each pulse is an LLM turn, bounded by OPPORTUNITY_HEARTBEAT_MAX.
#
# The code default is opt-in/off (DEFAULT_HEARTBEAT_ENABLED = False). This project's
# .env INTENTIONALLY enables it at a 200s cadence so a suspended watch keeps
# re-checking the setup and streaming a fresh Best_Current_Read into the glass box.
# This is safe because the R6 acquisition gate blocks a premature stand-aside: the
# heartbeat cannot force an idle/stand-aside decision before core data acquisition
# resolves (degraded pulses are labelled data_degraded rather than acted on). Leave
# these commented to keep the opt-in/off default, or set as shown to enable it.
# OPPORTUNITY_HEARTBEAT_ENABLED=true
# OPPORTUNITY_HEARTBEAT_CADENCE_SECS=200   # pulse every 200s during a wait (> 0)
# OPPORTUNITY_HEARTBEAT_MAX=6              # hard cap on pulses per session (>= 0)
#
# TIERED LADDER — take the best-available setup at scaled size. Default ON
# (b_continuation + scalp enabled). Set to false to restore the A+-only policy.
# OPPORTUNITY_LOWER_TIERS_ENABLED=true
# OPPORTUNITY_SIZE_FACTOR_A_PLUS=1.0          # full size for an A+ setup, in (0, 1]
# OPPORTUNITY_SIZE_FACTOR_B_CONTINUATION=0.6  # reduced size for a continuation
# OPPORTUNITY_SIZE_FACTOR_SCALP=0.3           # small size for a scalp
#
# BOUNDED HUNT — closes the analyze -> watch -> invalidate -> re-watch loop.
# OPPORTUNITY_WATCH_CAP=3                  # max watch cycles per session (>= 1)
# OPPORTUNITY_SESSION_MAX_TURNS=40         # model-turn budget per session (>= 1)
# OPPORTUNITY_SESSION_MAX_WALL_SECS=3600   # wall-clock budget per session (> 0)
#
# CONTEXT PRUNING — bounds the per-turn LLM context on long, many-resume hunts.
# OPPORTUNITY_PRUNE_KEEP_RECENT_TURNS=8    # recent turns always retained (>= 1)
# OPPORTUNITY_PRUNE_MAX_MESSAGES=40        # pruning ceiling (>= 1)

