# Remote state on OCI Object Storage (S3-compatible endpoint). Always Free: 20 GB.
# Copy to backend.hcl (gitignored), fill in, then:
#   tofu init -backend-config=backend.hcl -reconfigure
# and uncomment the `backend "s3" {}` block in versions.tf.
#
# One-time bootstrap (do once, by hand or a tiny separate stack):
#   1. Create a private bucket, e.g. "stratai-tfstate", in your compartment.
#   2. Find your Object Storage namespace:  oci os ns get
#   3. Create Customer Secret Keys for the user (Identity > Users > Customer Secret Keys)
#      — these become the S3 access_key / secret_key below. Store them as GH secrets.

bucket = "stratai-tfstate"
key    = "ai-trader/oci/terraform.tfstate"
region = "ap-mumbai-1"

# Namespace-scoped S3 compatibility endpoint:
#   https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
endpoints = {
  s3 = "https://<namespace>.compat.objectstorage.ap-mumbai-1.oraclecloud.com"
}

# S3 credentials = OCI Customer Secret Keys (set via env in CI, not here):
#   access_key / secret_key  ->  AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY

# OCI's S3 compatibility requires these skips:
skip_region_validation      = true
skip_credentials_validation = true
skip_metadata_api_check     = true
skip_requesting_account_id  = true
use_path_style              = true
