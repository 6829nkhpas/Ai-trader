# Caddy gateway for the Strat Ai data plane — one TLS domain fronts every
# desktop-facing endpoint (live WS feeds, QuestDB HTTP, deep-quant AI).
#
# Credentials for the basic-auth-protected routes are injected from the
# environment (see the questdb-gateway service in docker-compose.prod.yml):
#   QUESTDB_USER          — the basic-auth username (matches QuestDB PG user)
#   QUESTDB_PASSWORD_HASH — bcrypt hash of the password
#                           (generate: `docker run --rm caddy:2-alpine \
#                            caddy hash-password --plaintext '<password>'`)
#
# TLS certificates are provisioned automatically by Let's Encrypt for
# app.stratai.live and persisted in the caddy_data volume across restarts.

{
	admin off
	# `disable_redirects` keeps automatic HTTPS (so app.stratai.live gets a real
	# certificate) without adding a global HTTP->HTTPS redirect. Port 80 is still
	# used for the ACME challenge.
	auto_https disable_redirects
}

# ── Public gateway for the whole desktop-facing data plane (app.stratai.live) ─
# Automatic TLS fronts every endpoint the shipped desktop app talks to, so the
# installer carries NO raw droplet IP. Caddy detects `Upgrade: websocket` and
# proxies WS connections transparently; `handle_path` strips each route prefix
# so every upstream receives the exact path it already serves.
#
#   wss://app.stratai.live/ws/aggregator  -> aggregator:8080     (decisions)
#   wss://app.stratai.live/ws/alpha       -> alpha-terminal:8081 (OHLC candles)
#   wss://app.stratai.live/ws/predictive  -> predictive:8082     (ghost line)
#   wss://app.stratai.live/ws/insight     -> quant-rag:8083      (market insight)
#   https://app.stratai.live/questdb/*    -> questdb:9000        (HTTP /exec, basic-auth)
#   https://app.stratai.live/deepquant/*  -> deep-quant:8086     (glass-box SSE, basic-auth)
#
# Requires: a DNS A/AAAA record for app.stratai.live -> this droplet, and the
# firewall open on 80 (ACME challenge) + 443 (see infra/variables.tf and the
# compose gateway port mappings). Internal containers reach QuestDB/deep-quant
# directly by service name, so no host ports are published for them.
app.stratai.live {
	handle_path /ws/aggregator* {
		reverse_proxy aggregator:8080
	}
	handle_path /ws/alpha* {
		reverse_proxy alpha-terminal:8081
	}
	handle_path /ws/predictive* {
		reverse_proxy predictive:8082
	}
	handle_path /ws/insight* {
		reverse_proxy quant-rag:8083
	}

	# ── QuestDB HTTP query endpoint (/questdb/* -> questdb:9000) ──────────────
	# The desktop hits …/questdb/exec?query=… ; handle_path strips /questdb so
	# the upstream receives /exec exactly as a direct connection would.
	handle_path /questdb/* {
		basic_auth {
			{$QUESTDB_USER} {$QUESTDB_PASSWORD_HASH}
		}
		reverse_proxy questdb:9000
	}

	# ── Deep-quant AI service (/deepquant/* -> deep-quant:8086) ───────────────
	# Fronts the glass-box /run, /qa, /resume, /cancel endpoints. `flush_interval
	# -1` disables buffering so the SSE stream reaches the client as it is
	# produced.
	handle_path /deepquant/* {
		basic_auth {
			{$QUESTDB_USER} {$QUESTDB_PASSWORD_HASH}
		}
		reverse_proxy deep-quant:8086 {
			flush_interval -1
		}
	}

	# ── Kite REST proxy (/kite/* -> ingestion:8087/api/kite/*) ────────────────
	# The aggregator's Kite proxy (historical candles, quotes, instrument
	# search) is served by the ingestion container on 8087. The desktop fetches
	# …/kite/historical?…; handle_path strips /kite and the rewrite restores the
	# upstream's /api/kite prefix, so ingestion receives /api/kite/historical
	# exactly as the dev rewrite (next.config /kite/* -> :8087/api/kite/*) does.
	# basic_auth (same credentials as the questdb/deepquant routes) prevents the
	# public endpoint from being used to exhaust the shared Kite rate limit.
	handle_path /kite/* {
		basic_auth {
			{$QUESTDB_USER} {$QUESTDB_PASSWORD_HASH}
		}
		rewrite * /api/kite{uri}
		reverse_proxy ingestion:8087
	}

	# Friendly root / health probe (returns 200 for a plain GET).
	respond / "Strat Ai gateway" 200
}
