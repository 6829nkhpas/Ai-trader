# Caddy gateway for QuestDB HTTP (/exec, web console) — basic-auth protected.
#
# Fronts the internal `questdb:9000` (not published to the host) and requires
# HTTP Basic auth. Credentials are injected from the environment:
#   QUESTDB_USER          — the basic-auth username (matches QuestDB PG user)
#   QUESTDB_PASSWORD_HASH — bcrypt hash of the password
#                           (generate: `docker run --rm caddy:2-alpine \
#                            caddy hash-password --plaintext '<password>'`)
#
# NOTE: This listens on plain HTTP (the droplet has no domain, only an IP, so
# Caddy's automatic HTTPS cannot issue a public cert). Basic-auth credentials
# therefore travel base64-encoded, not encrypted. For production, point a
# domain at the droplet and switch this to `https://questdb.example.com` so
# Caddy provisions a real certificate automatically.

{
	admin off
	# Automatic HTTPS is ENABLED so the app.stratai.live WSS gateway (below) gets
	# a real Let's Encrypt certificate. `disable_redirects` stops Caddy adding a
	# global HTTP->HTTPS redirect, so the plain-HTTP, port-only sites below
	# (:9000 QuestDB, :8086 deep-quant — both basic-auth over the droplet IP)
	# keep serving over HTTP exactly as before.
	auto_https disable_redirects
}

:9000 {
	basic_auth {
		{$QUESTDB_USER} {$QUESTDB_PASSWORD_HASH}
	}
	reverse_proxy questdb:9000
}

# Deep-quant AI service (:8086) — same shared beta credential. Fronts the
# internal `deep-quant:8086` (not published to the host). The desktop thin
# client sends the analysis /run, /qa, /cancel requests here and receives the
# glass-box SSE stream; `flush_interval -1` disables response buffering so
# Server-Sent Events are streamed to the client as they arrive.
:8086 {
	basic_auth {
		{$QUESTDB_USER} {$QUESTDB_PASSWORD_HASH}
	}
	reverse_proxy deep-quant:8086 {
		flush_interval -1
	}
}

# ── Public WSS gateway for the live data-plane feeds (app.stratai.live) ─────
# Fronts the four internal WebSocket services with automatic TLS so desktop
# clients connect over ONE wss:// domain instead of the raw droplet IP:port.
# Caddy detects the `Upgrade: websocket` header and proxies the connection
# transparently (bidirectional streaming, no buffering config needed).
#
# `handle_path` strips the matched route prefix, so each upstream receives the
# "/" path it already serves today (identical to a direct ws://host:<port>).
#
#   wss://app.stratai.live/ws/aggregator  -> aggregator:8080     (decisions)
#   wss://app.stratai.live/ws/alpha       -> alpha-terminal:8081 (OHLC candles)
#   wss://app.stratai.live/ws/predictive  -> predictive:8082     (ghost line)
#   wss://app.stratai.live/ws/insight     -> quant-rag:8083      (market insight)
#
# Requires: a DNS A/AAAA record for app.stratai.live -> this droplet, and the
# firewall open on 80 (ACME challenge) + 443 (see infra/*.tf and the compose
# gateway port mappings).
app.stratai.live {
	handle_path /ws/aggregator* {
		reverse_proxy aggregator:8080
	}
	handle_path /ws/alpha* {
		reverse_proxy alpha-terminal:8081
	}
	handle_path /ws/predictive* {
		reverse_proxy predictive:8082
	}
	handle_path /ws/insight* {
		reverse_proxy quant-rag:8083
	}

	# Friendly root / health probe (returns 200 for a plain GET).
	respond / "Strat Ai WSS gateway" 200
}
