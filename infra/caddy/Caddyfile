# Caddy gateway for Strat Ai. Two TLS domains, served by this one container:
#
#   app-api.stratai.live — the data plane (live WS feeds, QuestDB HTTP,
#                          deep-quant AI). Basic-auth on everything that reads
#                          data; a shared credential, also compiled into desktop
#                          installers.
#   app.stratai.live     — the public web app (Next.js). NO basic-auth; the JWT
#                          is the auth boundary. See the vhost at the bottom.
#
# Credentials for the basic-auth-protected routes are injected from the
# environment (see the questdb-gateway service in docker-compose.prod.yml):
#   QUESTDB_USER          — the basic-auth username (matches QuestDB PG user)
#   QUESTDB_PASSWORD_HASH — bcrypt hash of the password
#                           (generate: `docker run --rm caddy:2-alpine \
#                            caddy hash-password --plaintext '<password>'`)
#
# TLS certificates are provisioned automatically by Let's Encrypt for both
# domains and persisted in the caddy_data volume across restarts.
{
	admin off
	# `disable_redirects` keeps automatic HTTPS (so app-api.stratai.live gets a real
	# certificate) without adding a global HTTP->HTTPS redirect. Port 80 is still
	# used for the ACME challenge.
	auto_https disable_redirects
}

# ── Public gateway for the whole desktop-facing data plane (app-api.stratai.live) ─
# Automatic TLS fronts every endpoint the shipped desktop app talks to, so the
# installer carries NO raw droplet IP. Caddy detects `Upgrade: websocket` and
# proxies WS connections transparently; `handle_path` strips each route prefix
# so every upstream receives the exact path it already serves.
#
#   wss://app-api.stratai.live/ws/aggregator  -> aggregator:8080     (decisions)
#   wss://app-api.stratai.live/ws/alpha       -> alpha-terminal:8081 (OHLC candles)
#   wss://app-api.stratai.live/ws/predictive  -> predictive:8082     (ghost line)
#   wss://app-api.stratai.live/ws/insight     -> quant-rag:8083      (market insight)
#   https://app-api.stratai.live/questdb/*    -> questdb:9000        (HTTP /exec, basic-auth)
#   https://app-api.stratai.live/deepquant/*  -> deep-quant:8086     (glass-box SSE, basic-auth)
#   https://app-api.stratai.live/status/*     -> status-api:9110     (fleet health JSON, basic-auth)
#   https://app-api.stratai.live/prometheus/* -> prometheus:9090     (TSDB console, basic-auth)
#   https://app-api.stratai.live/grafana/*    -> grafana:3000        (dashboards, basic-auth)
#
# Requires: a DNS A/AAAA record for app-api.stratai.live -> this droplet, and the
# firewall open on 80 (ACME challenge) + 443 (see infra/variables.tf and the
# compose gateway port mappings). Internal containers reach QuestDB/deep-quant
# directly by service name, so no host ports are published for them.
app-api.stratai.live {
	handle_path /ws/aggregator* {
		reverse_proxy aggregator:8080
	}
	handle_path /ws/alpha* {
		reverse_proxy alpha-terminal:8081
	}
	handle_path /ws/predictive* {
		reverse_proxy predictive:8082
	}
	handle_path /ws/insight* {
		reverse_proxy quant-rag:8083
	}

	# ── QuestDB HTTP query endpoint (/questdb/* -> questdb:9000) ──────────────
	# The desktop hits …/questdb/exec?query=… ; handle_path strips /questdb so
	# the upstream receives /exec exactly as a direct connection would.
	handle_path /questdb/* {
		basic_auth {
			{$QUESTDB_USER} {$QUESTDB_PASSWORD_HASH}
		}
		reverse_proxy questdb:9000
	}

	# ── Deep-quant AI service (/deepquant/* -> deep-quant:8086) ───────────────
	# Fronts the glass-box /run, /qa, /resume, /cancel endpoints. `flush_interval
	# -1` disables buffering so the SSE stream reaches the client as it is
	# produced.
	handle_path /deepquant/* {
		basic_auth {
			{$QUESTDB_USER} {$QUESTDB_PASSWORD_HASH}
		}
		reverse_proxy deep-quant:8086 {
			flush_interval -1
		}
	}

	# ── Kite REST proxy (/kite/* -> aggregator:8087/api/kite/*) ───────────────
	# The aggregator container runs the Kite REST proxy (historical candles,
	# quotes, instrument search) on 0.0.0.0:8087. (The host publishes 8087 via
	# the ingestion container, but the HTTP server itself lives in aggregator —
	# reach it internally as aggregator:8087.) The desktop fetches
	# …/kite/historical?…; handle_path strips /kite and the rewrite restores the
	# upstream's /api/kite prefix, so aggregator receives /api/kite/historical
	# exactly as the dev rewrite (next.config /kite/* -> :8087/api/kite/*) does.
	# basic_auth (same credentials as the questdb/deepquant routes) prevents the
	# public endpoint from being used to exhaust the shared Kite rate limit.
	handle_path /kite/* {
		basic_auth {
			{$QUESTDB_USER} {$QUESTDB_PASSWORD_HASH}
		}
		rewrite * /api/kite{uri}
		reverse_proxy aggregator:8087
	}

	# ── Quant tool server (/tools/* -> tool-server:8084/tools/*) ──────────────
	# `handle`, NOT `handle_path` — the prefix is deliberately KEPT.
	#
	# tool-server mounts every route under /tools (see tool-server/src/main.rs
	# `build_router`), and `app/api/_gateway.ts::upstreamBase('tools')` resolves to
	# `{base}/tools` and then appends the `[...path]`. So a request arrives here as
	# /tools/get_candles and the upstream must receive /tools/get_candles. Stripping
	# it (as the questdb/deepquant/kite routes correctly do, because those upstreams
	# serve from /) would hand tool-server a path it does not route and every
	# analytics call would 404 while both sides looked healthy. That exact 404-vs-405
	# distinction is recorded in the comment on `upstreamBase`.
	#
	# Added for the Vercel frontend. While the frontend ran on this box its
	# QUANT_TOOL_SERVER_URL pointed at http://tool-server:8084 over the docker
	# network, so it never traversed this gateway and no route was needed.
	handle /tools/* {
		basic_auth {
			{$QUESTDB_USER} {$QUESTDB_PASSWORD_HASH}
		}
		reverse_proxy tool-server:8084
	}

	# ── News sentiment (/sentiment/* -> sentiment:8090) ────────────────────────
	# `handle_path`, so exactly ONE /sentiment is stripped.
	#
	# `app/api/sentiment/route.ts` builds `${upstreamBase('sentiment')}/sentiment`,
	# and in gateway mode that base is already `{base}/sentiment` — so the request
	# lands here as /sentiment/sentiment?symbol=X. Stripping the outer prefix leaves
	# /sentiment?symbol=X, which is what the Node service serves and exactly what it
	# received over the docker network. The doubling looks like a mistake and is not.
	#
	# Added for the Vercel frontend, same reason as /tools above.
	handle_path /sentiment/* {
		basic_auth {
			{$QUESTDB_USER} {$QUESTDB_PASSWORD_HASH}
		}
		reverse_proxy sentiment:8090
	}

	# ── Status API (/status/* -> status-api:9110) ──────────────────────────────
	# The admin panel at dashboard.stratai.live calls /status/api/status to poll
	# fleet health. handle_path strips /status, so the upstream receives
	# /api/status exactly as it serves it.
	#
	# The OPTIONS carve-out is load-bearing, not a loophole. The panel sends an
	# Authorization header, which makes the browser fire a CORS preflight — and a
	# preflight is sent WITHOUT credentials by specification. With basic_auth
	# applied to every method, Caddy would 401 that preflight and the real request
	# would never leave the browser, so the endpoint would be unreachable from the
	# panel while working perfectly under curl. A preflight carries no request body
	# and returns no data; only the CORS headers status-api itself emits, which are
	# already pinned to the dashboard origin. Every method that can actually read
	# anything still requires the password.
	handle_path /status/* {
		@authenticated not method OPTIONS
		basic_auth @authenticated {
			{$QUESTDB_USER} {$QUESTDB_PASSWORD_HASH}
		}
		reverse_proxy status-api:9110
	}

	# ── Prometheus (/prometheus/* -> prometheus:9090) ──────────────────────────
	# The engineer-facing TSDB console. Prometheus itself is configured with
	# --web.external-url so its own redirects and alert "Source" links point back
	# through this gateway rather than at the unreachable internal service name.
	handle_path /prometheus/* {
		basic_auth {
			{$QUESTDB_USER} {$QUESTDB_PASSWORD_HASH}
		}
		reverse_proxy prometheus:9090
	}

	# ── Grafana (/grafana/* -> grafana:3000) ───────────────────────────────────
	# `handle`, NOT `handle_path` — the prefix is deliberately NOT stripped here.
	# The compose file sets GF_SERVER_SERVE_FROM_SUB_PATH=true, which means
	# Grafana routes on paths that still carry /grafana. Stripping it (as the
	# Prometheus route above correctly does, because Prometheus runs with
	# --web.route-prefix=/) would give Grafana a path it does not serve and the
	# app would 404 on every asset. These two upstreams genuinely differ; the
	# asymmetry below is not an oversight.
	handle /grafana/* {
		basic_auth {
			{$QUESTDB_USER} {$QUESTDB_PASSWORD_HASH}
		}
		reverse_proxy grafana:3000
	}

	# ── Desktop auto-update feed (/updates/* -> static files) ─────────────────
	#
	# ⚠ VESTIGIAL. The desktop shell was retired (frontend/src-tauri and
	# .github/workflows/desktop-release.yml are both deleted), so nothing writes
	# /srv/updates any more and no new client polls it. It is kept ONLY because
	# already-installed builds in the wild still check this feed on launch: with the
	# route removed they would get a 404 from the app.stratai.live vhost's catch-all
	# instead of a clean "no update", and there is no upside to that. Delete the
	# route, the /srv/updates bind mount in docker-compose.prod.yml, and the
	# directory once you are satisfied no installed copies remain.
	#
	# Layout it serves (was written by the release workflow over SSH):
	#
	#   /srv/updates/windows-x86_64/latest.json
	#   /srv/updates/windows-x86_64/Strat Ai_<ver>_x64-setup.exe
	#   /srv/updates/darwin-universal/latest.json
	#   /srv/updates/darwin-universal/Strat Ai_<ver>_universal.app.tar.gz
	#
	# basic_auth is NOT optional while it exists. The installers have credentials
	# compiled into them, so an open feed would hand those to anyone who fetched a
	# build. The desktop sends this header from its already-baked credential, so no
	# new secret exists.
	#
	# Auth only proves the feed is ours; payload authenticity is enforced
	# independently by the updater's minisign check against the baked pubkey, so a
	# valid-looking response still cannot ship code we did not sign.
	handle_path /updates/* {
		basic_auth {
			{$QUESTDB_USER} {$QUESTDB_PASSWORD_HASH}
		}
		root * /srv/updates
		file_server
	}

	# Friendly root / health probe (returns 200 for a plain GET).
	respond / "Strat Ai gateway" 200
}

# ── The web app (app.stratai.live) ────────────────────────────────────────────
# Serves the Next.js terminal to end users. Deliberately NOT behind basic_auth:
# this is the public product and the session cookie (issued by the separate
# api-web.stratai.live deployment) is the auth boundary. Adding a shared
# gateway password here would mean every prospective user needed a secret that is
# also compiled into desktop installers.
#
# The terminal has no login form: an unauthenticated visitor is redirected to
# auth.stratai.live, which authenticates them and sets `access_token` /
# `refresh_token` as httpOnly cookies for `domain=.stratai.live`. Because this
# vhost is a subdomain of that, the browser presents the session here with no
# handoff — which is also why the https redirect below is not optional.
#
# The container holds NO gateway credential. `frontend`'s compose environment
# points each upstream at its internal service name (KITE_API_URL,
# QUESTDB_HTTP_URL, DEEP_QUANT_URL, QUANT_TOOL_SERVER_URL, SENTIMENT_HTTP_URL),
# so its same-origin /api/* route handlers reach aggregator/QuestDB/deep-quant/
# tool-server/sentiment directly over the stratai network and never traverse this
# gateway.
#
# That used to be the reason no /tools or /sentiment route existed above. Both are
# now present, because the frontend is additionally deployed on Vercel, where
# there is no docker network and every upstream has to come through this gateway
# with STRATAI_HTTP_BASE_URL=https://app-api.stratai.live. This vhost stays as the
# on-box fallback; whichever of the two serves app.stratai.live is a DNS decision.
#
# Requires: a DNS A record for app.stratai.live -> this droplet, and
# https://app.stratai.live on the CORS allowlist of the api-web deployment (out of
# this repo, `src/core/security/allowed-domains.ts`) — with `credentials: true`,
# which it has. Verified against production: an OPTIONS preflight for
# /api/v1/users/me with `Origin: https://app.stratai.live` returns
# `Access-Control-Allow-Origin: https://app.stratai.live` and
# `Access-Control-Allow-Credentials: true`. Without both, every authenticated
# request from this origin fails preflight and the app reads a live session as
# logged out.
app.stratai.live {
	# Compression is not cosmetic here: the app ships a 526 kB first-load JS bundle
	# plus the TradingView Advanced Charts library (~31 MB of static assets under
	# /static/charting_library/). Next's standalone server does not compress on its
	# own behalf, so without this every cold visit transfers all of it raw.
	encode zstd gzip

	# Baseline hardening for a public financial app. `frame-ancestors 'none'`
	# (superseding X-Frame-Options) is the load-bearing one: a trading terminal
	# framed by a third party is a clickjacking target where the clicks place
	# orders. The rest are cheap and uncontroversial.
	header {
		Content-Security-Policy "frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Caddy advertises itself by default; nothing gains from telling the world.
		-Server
	}

	reverse_proxy frontend:3000
}

# HTTP -> HTTPS for the app, explicitly.
#
# The global `auto_https disable_redirects` above suppresses Caddy's automatic
# redirect, which is correct for the API gateway (its clients always dial https
# and the flag keeps port 80 free for the ACME challenge). But a HUMAN types
# `app.stratai.live` with no scheme, and without this block that request would be
# served over plaintext — breaking the wss:// feeds as mixed content, and
# breaking auth outright: the session cookies are `Secure; SameSite=None`, so a
# browser will not send them over http and every request would read as logged
# out. So the redirect is restored for this one site only.
http://app.stratai.live {
	redir https://{host}{uri} permanent
}
