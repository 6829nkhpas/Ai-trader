# Copy to terraform.tfvars (gitignored) and fill in.
# In CI, provide these as TF_VAR_* environment variables instead.

# ── DigitalOcean API token (create at: Console -> API -> Tokens, scope: read+write) ──
do_token = "dop_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── SSH key already generated in this repo (OpenSSH format) ──
ssh_public_key_path = "../../keys/thestratai_ssh.pub"

# ── Droplet ──
region       = "blr1"          # Bangalore. Alternatives: sgp1, fra1, lon1, nyc3, sfo3
droplet_size = "s-4vcpu-8gb"   # 4 vCPU / 8 GB (~$48/mo). Comfortable: s-8vcpu-16gb
droplet_name = "stratai-beta"

# ── Optional hardening: restrict who can reach SSH / app ports ──
# ssh_ingress_cidrs = ["203.0.113.10/32"]
# app_ingress_cidrs = ["0.0.0.0/0", "::/0"]

# enable_backups = false
