# Copy to terraform.tfvars (gitignored) and fill in.
# In CI, provide these as TF_VAR_* environment variables instead.
#
# Authentication is NOT a variable. The google provider uses Application Default
# Credentials, so authenticate first:
#
#   gcloud auth application-default login
#   gcloud config set project <your-project-id>
#
# ── Required ────────────────────────────────────────────────────────────────────
project_id = "stratai-prod"

# ── Location. asia-south1 = Mumbai, the closest region to the NSE. ─────────────
region = "asia-south1"
zone   = "asia-south1-c"

# ── Instance. e2-custom-4-8192 is 4 vCPU / 8 GB — the droplet's s-4vcpu-8gb. ───
# For the headroom docker-compose.prod.yml recommends, use e2-standard-4 (4/16)
# and drop -f docker-compose.8gb.yml from COMPOSE_FILES on the box.
machine_type      = "e2-custom-4-8192"
boot_disk_size_gb = 160

# ── SSH. Generate a FRESH key for this migration: ─────────────────────────────
#   ssh-keygen -t ed25519 -f keys/stratai_gcp -C stratai-gcp -N ""
ssh_public_key_path = "../../keys/stratai_gcp.pub"

# ── Hardening. Narrow SSH to your own address once CI auth is sorted. ─────────
# ssh_ingress_cidrs = ["203.0.113.10/32"]

# The raw TCP ports (8085 ingestion control, 8087 Kite OAuth, 8812 QuestDB wire)
# create NO firewall rule while this is empty, which is the safe default: 8085
# accepts unauthenticated commands that repoint the market data feed. Add only the
# addresses that genuinely need them.
# control_ingress_cidrs = ["203.0.113.10/32"]
