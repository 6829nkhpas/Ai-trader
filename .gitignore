# ===========================
# AI-Trade Monorepo .gitignore
# ===========================

# ----- Rust -----
target/
**/*.rs.bk
# Cargo.lock is committed for these binary/service crates so Docker builds use
# the exact tested dependency versions (prevents fresh-resolution breakage).
*.pdb
.kiro
# Ignore stale static build outputs but ALLOW the TradingView charting_library
# submodule at frontend/public/static/charting_library (needed for CI builds).
# The negation (!) must come AFTER the broad ignore for git to honour it.
frontend/public/static/*
!frontend/public/static/charting_library
!frontend/public/static/tvThemeOverrides.css
# ----- Node.js / Next.js -----
node_modules/
.next/
out/
.turbo/
dist/
build/
*.tsbuildinfo
.npm
.yarn/cache
.yarn/unplugged
.yarn/install-state.gz
.pnp.*
.claude/

# ----- Go -----
bin/
vendor/
*.exe
*.exe~
*.dll
*.so
*.dylib

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
*.egg

# ----- Trade Journal (local measurement DB, not source) -----
trade_journal.db
telemetry.db
*.sqlite
*.sqlite3

# ----- Environment & Secrets -----
.env
.env.local
.env.*.local
*.key
*.crt

# ----- Docker -----
docker-volumes/
*.tar
docker-compose.override.yml

# ----- IDE / Editor -----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Logs & Temp -----
logs/
*.log
tmp/
temp/
*.tmp

# ----- OS -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# ----- Proto generated -----
*_pb2.py
*_pb2_grpc.py
*.pb.go


# ----- Graphify -----
/graphify-out



# ----- Secrets & Environment -----
.env
.env.*
!.env.example
bedrock-api-key.txt
*.pem
*.key
# ----- Local Tools -----
tools/cmake-3.30.0/
# Added by code-review-graph
.code-review-graph/

# server Key 
keys

.kiro/