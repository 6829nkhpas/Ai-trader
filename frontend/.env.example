# Strat AI frontend environment
# Copy to .env.local and override as needed. Both URLs are public (no secrets).

NEXT_PUBLIC_API_BASE_URL=https://api-web.stratai.live
NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.stratai.live

# Production mode gates premium features by the user's plan accessFlags.
# Leave `false` in dev to test every feature freely.
NEXT_PUBLIC_PROD=false

# Per-feature kill switches. When NEXT_PUBLIC_PROD=true, a feature is usable
# only if its env var is `true` AND the user's plan accessFlags grant it.
# In dev (NEXT_PUBLIC_PROD=false) these are ignored and everything is unlocked.
NEXT_PUBLIC_ENABLE_DEEPSEEK_GLM=true
NEXT_PUBLIC_ENABLE_MULTI_MODEL=true
NEXT_PUBLIC_ENABLE_GHOSTLINE=true
NEXT_PUBLIC_ENABLE_FOOTPRINT=true
NEXT_PUBLIC_ENABLE_TOPUP=true
NEXT_PUBLIC_ENABLE_INSTANT_NEWS=true
NEXT_PUBLIC_ENABLE_ADVANCE_CHART=true
