# Strat AI frontend environment
# Copy to .env.local and override as needed. Both URLs are public (no secrets).

NEXT_PUBLIC_API_BASE_URL=https://api-web.stratai.live
NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.stratai.live

# ── Browser-mode service URLs (ignored in the Tauri desktop build, which uses
#    IPC + live_bridges instead of these). Only used when the frontend runs in a
#    plain browser via `npm run dev`. Defaults match the local dev services. ──
# Auth/broker/credit API. This service is NOT in this repo — it is a separate
# deployment, so point this at the real host (same value as
# NEXT_PUBLIC_API_BASE_URL above). There is no local auth service to run.
NEXT_PUBLIC_AUTH_SERVICE_URL=https://api-web.stratai.live
#
# Live WebSocket feeds. Shipped builds route these through the single TLS
# gateway (see infra/caddy/Caddyfile):
#   NEXT_PUBLIC_AGGREGATOR_WS_URL=wss://app-api.stratai.live/ws/aggregator
#   NEXT_PUBLIC_ALPHA_WS_URL=wss://app-api.stratai.live/ws/alpha
#   NEXT_PUBLIC_PREDICTIVE_WS_URL=wss://app-api.stratai.live/ws/predictive
#   NEXT_PUBLIC_INSIGHT_WS_URL=wss://app-api.stratai.live/ws/insight
# For local dev against the live droplet before DNS/TLS is up you can point them
# straight at the IP (ws://168.144.86.130:8080-8083). Defaults below are the
# on-machine local services. NOTE: in the Tauri desktop build only the aggregator
# URL is consumed here; the other three feeds are bridged in Rust via
# STRATAI_WS_BASE_URL (see .env.example / server.rs).
NEXT_PUBLIC_ALPHA_WS_URL=ws://127.0.0.1:8081
NEXT_PUBLIC_PREDICTIVE_WS_URL=ws://127.0.0.1:8082
NEXT_PUBLIC_INSIGHT_WS_URL=ws://127.0.0.1:8083
# Decision/consensus WebSocket (aggregator). Falls back to ws://127.0.0.1:8080.
NEXT_PUBLIC_AGGREGATOR_WS_URL=ws://127.0.0.1:8080

# Production mode. Gates the regulated RESEARCH surface (lib/sku.ts) and the
# `IS_PROD` UI switches. Leave `false` in dev.
NEXT_PUBLIC_PROD=false

# ── Feature kill switches — SERVER-SIDE, deliberately NOT NEXT_PUBLIC_ ─────────
# These are read by the server, never inlined into the JS bundle:
#   web     → app/api/_featureSwitches.ts, served by GET /api/features
#   desktop → src-tauri/src/commands/features.rs (option_env! bake at build time)
# The `NEXT_PUBLIC_` prefix is what would ship a value to the browser, where it
# is readable and editable in devtools — so the absence of the prefix here is
# load-bearing, not a style choice. It also means flipping a switch on the web
# is a container restart rather than a rebuild.
#
# `FEATURE_ENFORCEMENT=true` turns enforcement on; a feature is then usable only
# if its switch is truthy AND the user's plan accessFlags grant it. When unset the
# deployment is treated as local dev and everything is unlocked. (Not named
# `PROD`: that collides with the reserved `import.meta.env.PROD` in the test
# tooling, and is too generic for a container variable this load-bearing.)
# Truthy spellings: true / 1 / yes / on (case-insensitive).
FEATURE_ENFORCEMENT=false
ENABLE_DEEPSEEK_GLM=true
ENABLE_MULTI_MODEL=true
ENABLE_GHOSTLINE=true
ENABLE_FOOTPRINT=true
ENABLE_TOPUP=true
ENABLE_INSTANT_NEWS=true
ENABLE_ADVANCE_CHART=true
